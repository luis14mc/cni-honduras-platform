# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep templates unignored for collaborators)
.env
.env.*
!.env.example
!backend/.env.example
!cms-strapi/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
/next-env.d.ts

# Monorepo — frontend (Next.js)
/frontend/node_modules/
/frontend/.next/
/frontend/out/

# Monorepo — Strapi 5 editorial CMS
/cms-strapi/node_modules/
/cms-strapi/.tmp/
/cms-strapi/dist/
/cms-strapi/build/
/cms-strapi/.cache/
/cms-strapi/.strapi/
/cms-strapi/.strapi-updater.json
/cms-strapi/.strapi-cloud.json
/cms-strapi/public/uploads/*
!/cms-strapi/public/uploads/.gitkeep

# Backend / Python
**/__pycache__/
*.py[cod]
.venv/
.venv-ci/
venv/
/backend/staticfiles/
# User uploads (only .gitkeep is tracked)
/backend/media/*
!/backend/media/.gitkeep
