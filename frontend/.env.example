# Frontend environment (copy to frontend/.env.local)
#
# Public API base — no trailing slash on /api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public site URL (sitemap, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS environment badge: production | staging | development
# If unset, inferred from VERCEL_ENV or NODE_ENV.
NEXT_PUBLIC_CMS_ENV=development

# Optional: allow next/image for a public media/CDN hostname (no provider hardcoding).
# NEXT_PUBLIC_MEDIA_HOSTNAME=cdn.example.com

# Strapi 5 editorial CMS (parallel to Django).
# STRAPI_ORIGIN is server-only (never NEXT_PUBLIC_*).
STRAPI_ORIGIN=http://localhost:1337
NEXT_PUBLIC_STRAPI_URL=/strapi-api
# STRAPI_API_TOKEN=

# Staging example (do not commit secrets):
# NEXT_PUBLIC_API_URL=https://api-test.cni.hn/api/v1
# NEXT_PUBLIC_SITE_URL=https://test.cni.hn
# NEXT_PUBLIC_CMS_ENV=staging
# STRAPI_ORIGIN=https://<strapi-service>.onrender.com
# NEXT_PUBLIC_STRAPI_URL=/strapi-api
