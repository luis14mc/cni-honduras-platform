# Copy to ``backend/.env`` and adjust for your machine.
# Local development with docker-compose PostGIS: host ``localhost``, port ``5432``.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=admin123
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgis://cni_user:cni_pass@localhost:5432/cni_db

# TEMPORARY Windows fallback if GDAL/GEOS aren't installed yet:
# DJANGO_ENABLE_GIS=False

DJANGO_LANGUAGE_CODE=es-hn
DJANGO_TIME_ZONE=America/Tegucigalpa

DJANGO_STATIC_URL=/static/
DJANGO_STATIC_ROOT_REL=staticfiles
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT_REL=media

# Next.js (dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GeoDjango (Windows + OSGeo4W optional): uncomment and point to installed DLLs after ``OSGeo4W Shell`` confirms versions.
# DJANGO_GDAL_LIBRARY_PATH=C:\\OSGeo4W\\bin\\gdal312.dll
# DJANGO_GEOS_LIBRARY_PATH=C:\\OSGeo4W\\bin\\geos_c.dll

# Production / reverse proxy (optional; used by ``config.settings.production``)
# DJANGO_USE_SECURE_PROXY_HEADERS=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
# DJANGO_SECURE_SSL_REDIRECT=False

# Staging (test.cni.hn frontend + api-test.cni.hn API) — cross-subdomain session cookies
# DJANGO_ALLOWED_HOSTS=api-test.cni.hn,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://test.cni.hn
# CORS_ALLOW_CREDENTIALS=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://test.cni.hn
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SESSION_COOKIE_SAMESITE=None
# DJANGO_CSRF_COOKIE_SAMESITE=None
# Requires HTTPS on both subdomains for SameSite=None + Secure cookies.

# Temporary superuser bootstrap (Render — no shell). Set only for first deploy,
# then remove or set CREATE_DJANGO_SUPERUSER=false after confirming /admin/ login.
# CREATE_DJANGO_SUPERUSER=false
# DJANGO_ADMIN_USERNAME=
# DJANGO_ADMIN_EMAIL=
# DJANGO_ADMIN_PASSWORD=

# Object storage for media (Render/staging/prod — optional; local dev uses filesystem)
# USE_S3_STORAGE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=              # S3 API endpoint (writes); not public read URL on R2
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=             # Public read domain (required for R2 when AWS_QUERYSTRING_AUTH=false)
# AWS_QUERYSTRING_AUTH=false
# AWS_S3_FILE_OVERWRITE=false
# AWS_S3_ADDRESSING_STYLE=path
# AWS_DEFAULT_ACL=

# n8n integration (optional — ``python manage.py process_webhook_events``)
# N8N_PROJECT_APPLICATION_WEBHOOK_URL=https://your-n8n-instance/webhook/project-application
