# CNI Strapi 5 — copy to cms-strapi/.env (never commit .env)
#
# Generate secrets locally, for example:
#   openssl rand -base64 32

HOST=0.0.0.0
PORT=1337

APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# i18n: first boot default locale (es). Bootstrap also ensures en exists.
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=es

# PostgreSQL (required for staging). Do not use SQLite in staging/production.
# Prefer a dedicated Neon/Postgres database (or schema) — never the Django PostGIS DB.
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SCHEMA=public

# Optional Neon connection URI (overrides host pieces when set by the driver).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Public URL of the site that reverse-proxies Strapi (no trailing slash).
# Local: http://localhost:3000  Staging example: https://test.cni.hn
# Leave empty to serve admin from this process host:port (e.g. :1337).
STRAPI_PUBLIC_URL=
# Admin path (relative to STRAPI_PUBLIC_URL). Keep /admin.
ADMIN_PATH=/admin
# Cloudflare R2 (required for staging media). Leave CF_BUCKET empty to use local uploads in dev.
CF_ACCESS_KEY_ID=
CF_ACCESS_SECRET=
CF_ENDPOINT=
CF_BUCKET=
# Public access URL, e.g. https://pub-xxxxxxxx.r2.dev
CF_PUBLIC_ACCESS_URL=
