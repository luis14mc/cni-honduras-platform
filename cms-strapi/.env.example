# CNI Strapi 5 — copy to cms-strapi/.env (never commit .env)
#
# Generate secrets locally, for example:
#   openssl rand -base64 32
#
# Staging (Render): NODE_ENV=production is set by the platform.
# Local develop: leave NODE_ENV unset or use `npm run develop`.

HOST=0.0.0.0
PORT=1337

APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
ENCRYPTION_KEY=tobemodified
JWT_SECRET=tobemodified

# i18n: first boot default locale (es). Bootstrap also ensures en exists.
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=es

# PostgreSQL (required for staging). Do not use SQLite in staging/production.
# Dedicated database — never the Django PostGIS instance.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SCHEMA=public
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Discrete fields (used when DATABASE_URL is empty):
# DATABASE_HOST=
# DATABASE_PORT=5432
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# Public URL of this Strapi process (no trailing slash).
# Staging (direct admin, no Next proxy required):
#   STRAPI_PUBLIC_URL=https://<strapi-service>.onrender.com
# Optional same-site proxy via Next: set this to the frontend origin instead.
STRAPI_PUBLIC_URL=
ADMIN_PATH=/admin

# Media storage — Cloudflare R2 (object storage).
#
# STRAPI_REQUIRE_R2 controls whether R2 is mandatory:
#   - Deployed environments (staging / production on Render): STRAPI_REQUIRE_R2=true
#     Strapi will REFUSE TO BOOT unless ALL five CF_* variables below are set.
#     This prevents falling back to the local filesystem, which is ephemeral on
#     Render (media is lost on every redeploy/restart).
#   - Local development: STRAPI_REQUIRE_R2=false (or unset)
#     If the five CF_* variables are all set, R2 is still used. If none are set,
#     Strapi uses local `public/uploads` and logs a visible warning.
#
# Note: a PARTIAL R2 configuration (some CF_* set, others empty) is rejected at
# boot in every environment — set all five or none.
STRAPI_REQUIRE_R2=true

# Required whenever STRAPI_REQUIRE_R2=true (and to enable R2 locally):
CF_ACCESS_KEY_ID=
CF_ACCESS_SECRET=
CF_ENDPOINT=
CF_BUCKET=
# Public access URL, e.g. https://pub-xxxxxxxx.r2.dev
CF_PUBLIC_ACCESS_URL=
