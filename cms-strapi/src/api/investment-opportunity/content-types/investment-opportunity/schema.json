{
  "kind": "collectionType",
  "collectionName": "investment_opportunities",
  "info": {
    "singularName": "investment-opportunity",
    "pluralName": "investment-opportunities",
    "displayName": "Investment Opportunity",
    "description": "Public teaser for investment opportunities. Private editorial notes are stripped from REST."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sector": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "code": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "public_metrics": {
      "type": "component",
      "repeatable": true,
      "component": "opportunity.public-metric",
      "max": 4,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contact_cta": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "internal_notes": {
      "type": "text",
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
