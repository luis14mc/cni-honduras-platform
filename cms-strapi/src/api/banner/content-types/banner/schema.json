{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Aviso del sitio",
    "description": "Mensajes temporales que se muestran en el portal."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "placement": {
      "type": "enumeration",
      "enum": [
        "site_top",
        "home_hero",
        "footer"
      ],
      "required": true,
      "default": "site_top",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "body": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta_label": {
      "type": "string",
      "maxLength": 120,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "link_url": {
      "type": "string",
      "maxLength": 500,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "link_external": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "dismissible": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "starts_at": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "ends_at": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "priority": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "background_color": {
      "type": "string",
      "regex": "^#[0-9a-fA-F]{6}$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "text_color": {
      "type": "string",
      "regex": "^#[0-9a-fA-F]{6}$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "mobile_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "legacy_key": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  },
  "config": {
    "metadatas": {
      "placement": {
        "edit": {
          "description": "Elige dónde aparecerá el aviso en el portal."
        }
      },
      "ends_at": {
        "edit": {
          "description": "El aviso deja de mostrarse a partir de esta fecha."
        }
      }
    }
  }
}
